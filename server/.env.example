PORT=5000
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
# Optional database name. When set it overrides the database in the URI.
MONGODB_DB=expensetracker
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# Cloudinary (receipt + profile photo storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@kharcha.app
# Secret used by Vercel Cron to call /api/cron/notify
CRON_SECRET=

# Admin access: comma-separated emails. The bootstrap password creates the first admin
# account if it does not exist yet (store it as a secret in Vercel).
ADMIN_EMAILS=
ADMIN_BOOTSTRAP_PASSWORD=

# Donation details shown on the public Donate page (placeholders by default)
DONATION_ESEWA_ID=
DONATION_ESEWA_NAME=
DONATION_BANK_NAME=
DONATION_BANK_ACCOUNT=
DONATION_BANK_BRANCH=
DONATION_BANK_SWIFT=
DONATION_QR_URL=
DONATION_NOTE=
